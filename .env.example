# Chave da API Anthropic — necessária apenas para rodar scripts/generate-articles.js
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP — necessário para o formulário de aplicação da página
# /4-week-experience/ (notificação para hello@salrayofficial.com + e-mail de
# confirmação automática). salraycoach.com ainda não tem e-mail configurado;
# hello@salrayofficial.com é a caixa real em uso (Gmail, com verificação em
# duas etapas + senha de app gerada em myaccount.google.com → Segurança →
# Senhas de app). SMTP_PASSWORD é a senha de app, não a senha normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@salrayofficial.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Lista de e-mail do PDF 1 (treinamento interativo de 30 dias).
# UNSUBSCRIBE_SECRET assina (HMAC-SHA256) os links de descadastro e de download
# de cada pessoa. Obrigatória em produção: string aleatória longa (32+
# caracteres). Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA troque depois de enviar e-mails: todos os links já enviados deixam de valer.
UNSUBSCRIBE_SECRET=troque-por-um-valor-aleatorio-longo
# Opcional: pasta onde ficam os arquivos first-steps-*.jsonl (inscritos,
# descadastros, downloads). Padrão: data/ dentro do projeto. Aponte para uma
# pasta FORA do diretório do deploy se o deploy da Hostinger apagar data/.
# FIRST_STEPS_DATA_DIR=/caminho/absoluto/fora/do/deploy

# Chave da rota POST /api/first-steps-cron (e-mails de apoio dos dias 3, 7 e 15),
# chamada pelo Cron Jobs da Hostinger com curl:
#   curl -X POST -H "Authorization: Bearer SEU_CRON_SECRET" https://salraycoach.com/api/first-steps-cron/
# Obrigatória em produção: string aleatória de 32+ caracteres. Sem ela a rota
# responde 401 a qualquer chamada.
CRON_SECRET=troque-por-um-valor-aleatorio-longo
