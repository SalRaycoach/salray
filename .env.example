# Chave da API Anthropic — necessária apenas para rodar scripts/generate-articles.js
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP da Hostinger — necessário para o formulário de aplicação da página
# /4-week-experience/ (notificação para hello@salraycoach.com + e-mail de
# confirmação automática). Valores em hPanel → E-mails → hello@salraycoach.com
# → Configurar cliente de e-mail. SMTP_USER é o endereço completo do e-mail;
# SMTP_PASSWORD é a senha da caixa postal (não a senha do hPanel).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@salraycoach.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxxxxxx
