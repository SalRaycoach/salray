# Chave da API Anthropic — necessária apenas para rodar scripts/generate-articles.js
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP — necessário para o formulário de aplicação da página
# /4-week-experience/ (notificação para hello@salrayofficial.com + e-mail de
# confirmação automática). salraycoach.com ainda não tem e-mail configurado;
# hello@salrayofficial.com é a caixa real em uso (Gmail, com verificação em
# duas etapas + senha de app gerada em myaccount.google.com → Segurança →
# Senhas de app). SMTP_PASSWORD é a senha de app, não a senha normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@salrayofficial.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
